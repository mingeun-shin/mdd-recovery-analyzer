# Free API key from https://twelvedata.com/pricing (no credit card required).
# Copy this file to .env.local and fill in your key.
TWELVE_DATA_API_KEY=

# Supabase — Project Settings > API in the dashboard.
# SERVICE_ROLE bypasses RLS: server-only, never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
