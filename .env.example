# Price data comes from Yahoo Finance's public endpoints, which need no key.
# Copy this file to .env.local and fill in the Supabase values.

# Supabase — Project Settings > API in the dashboard.
# SERVICE_ROLE bypasses RLS: server-only, never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
